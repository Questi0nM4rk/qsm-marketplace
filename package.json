{
  "name": "qsm-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "bun .gates/validate-plugin-contracts.ts && bun .gates/validate-file-size.ts && bun .gates/validate-no-cross-plugin-import.ts && bun .gates/validate-generated.ts && bun .gates/validate-why-it-exists.ts && bun .gates/validate-dependencies.ts",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit && bun .gates/typecheck-hooks.ts",
    "test:hooks": "bun .gates/test-hooks.ts",
    "plugin-types": "bun .gates/plugin-types.ts",
    "eval": "bun .gates/plugin-eval.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@questi0nm4rk/shell-ast": "0.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  },
  "license": "GPL-3.0",
  "patchedDependencies": {
    "@questi0nm4rk/shell-ast@0.8.0": "patches/@questi0nm4rk%2Fshell-ast@0.8.0.patch"
  }
}
