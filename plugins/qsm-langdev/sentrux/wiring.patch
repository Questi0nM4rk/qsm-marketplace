 //! depth heuristics. Handles depth-2 and depth-3 boundaries, dominant
 //! directory stripping (src/, lib/), and extension removal. Used throughout
 //! the metrics and analysis layers to assign files to logical modules.
-//! Public functions: `module_of`, `is_same_module`.
+//! Public functions: `module_of`, `module_of_at`, `is_same_module`,
+//! `set_module_depth`, `module_depth`.
+//!
+//! The depth at which a directory becomes a module is 3 by default and is
+//! configurable per repository through `[modules] depth` in
+//! `.sentrux/rules.toml` (qsm fork): a repository laid out as
+//! `tools/<name>/{lib,scripts}` is one module per tool at depth 2, and its
+//! `scripts -> lib` calls stop counting as cross-module edges.
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+/// Default: three directory levels, upstream's behaviour.
+const DEFAULT_MODULE_DEPTH: usize = 3;
+
+static MODULE_DEPTH: AtomicUsize = AtomicUsize::new(DEFAULT_MODULE_DEPTH);
+
+/// The directory depth at which a path becomes a module, for this process.
+pub fn module_depth() -> usize {
+    MODULE_DEPTH.load(Ordering::Relaxed)
+}
+
+/// Sets the module depth for this process; anything below 2 is 2, because a
+/// single top-level directory is a layer, not a module.
+pub fn set_module_depth(depth: usize) {
+    MODULE_DEPTH.store(depth.max(2), Ordering::Relaxed);
+}
 
