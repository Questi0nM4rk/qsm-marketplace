+/// Handle files at >=2 directory levels: the first `depth` directories, or
+/// every directory when the path has fewer than `depth`.
+fn module_of_deep(path: &str, depth: usize) -> &str {
+    let mut end = 0;
+    let mut seen = 0;
+    for (i, ch) in path.char_indices() {
+        if ch == '/' {
+            seen += 1;
+            end = i;
+            if seen == depth {
+                return &path[..end];
+            }
+        }
     }
+    &path[..end]
 }
 
