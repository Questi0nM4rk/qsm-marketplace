#!/usr/bin/env bash
# drive — sudo-free computer use on Hyprland/Wayland.
#
# Everything that must LOOK like real input goes through ydotool, because the
# compositor's own warp/send_shortcut dispatchers bypass the paths that make
# input observable: a warp emits no motion event (hover never fires) and
# send_shortcut is injected past bind processing (keybinds never run). hyprctl
# is used only to READ state and to park the pointer. See USAGE.md.
#
# Nothing here needs root. If a call fails, run `drive doctor` first.
# shellcheck disable=SC2154 # SLOT_OUTPUT comes from the slot state file
set -uo pipefail

OUT_DIR="${DRIVE_OUT_DIR:-${XDG_RUNTIME_DIR:-/tmp}/drive-shots}"
SETTLE="${DRIVE_SETTLE:-0.35}"

die() {
  printf 'drive: %s\n' "$*" >&2
  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || die "missing $1 (see: drive doctor)"; }

# Hyprland's lua-dialect config rejects the legacy `hyprctl dispatch movecursor X Y`
# string form outright, so every dispatcher goes through the hl.dsp.* call shape.
hdisp() { hyprctl dispatch "$1" >/dev/null || die "dispatch failed: $1"; }

# THE positioning command. Uses ydotool, NOT the compositor's warp dispatcher,
# because a warp repositions the pointer WITHOUT emitting a motion event — so
# Qt never fires hover-enter and nothing under the cursor reacts. Verified: a
# warp onto a rail cell left its popout closed; the same coordinates via ydotool
# opened it. If you are testing hover, you need a real motion event.
cmd_move() {
  in_slot && slot_move "$@" && return
  [[ $# -ge 2 ]] || die "move needs X Y (layout px)"
  need ydotool
  need jq
  local target_x="$1" target_y="$2" current_x current_y dx dy step_x step_y i
  [[ "$target_x" =~ ^-?[0-9]+$ && "$target_y" =~ ^-?[0-9]+$ ]] || die "move coordinates must be integers"
  for ((i = 0; i < 40; i++)); do
    current_x="$(hyprctl cursorpos -j | jq -er '.x | floor')" || die "could not read cursor position"
    current_y="$(hyprctl cursorpos -j | jq -er '.y | floor')" || die "could not read cursor position"
    dx=$((target_x - current_x))
    dy=$((target_y - current_y))
    if ((dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1)); then
      printf 'cursor confirmed: %s,%s\n' "$current_x" "$current_y"
      sleep "${3:-$SETTLE}"
      return
    fi
    step_x=$((dx * 6 / 10))
    step_y=$((dy * 6 / 10))
    ((step_x != 0 || dx == 0)) || step_x=$((dx > 0 ? 1 : -1))
    ((step_y != 0 || dy == 0)) || step_y=$((dy > 0 ? 1 : -1))
    ydotool mousemove -x "$step_x" -y "$step_y" || die "ydotool relative move failed"
    sleep 0.03
  done
  die "cursor did not reach target $target_x,$target_y within 40 steps"
}

# Compositor warp: exact and instant, but emits NO motion event, so hover does
# not fire. Useful only to park the pointer somewhere harmless.
cmd_warp() {
  [[ $# -ge 2 ]] || die "warp needs X Y"
  hdisp "hl.dsp.cursor.move({x=$1,y=$2})"
  sleep "${3:-$SETTLE}"
}

# Relative nudge, for probing hover thresholds without recomputing absolutes.
cmd_nudge() {
  [[ $# -ge 2 ]] || die "nudge needs DX DY"
  in_slot && slot_nudge "$@" && return
  local pos x y
  pos="$(hyprctl cursorpos)" || die "cursorpos failed"
  x="${pos%%,*}"
  y="${pos##*, }"
  cmd_move "$((x + $1))" "$((y + $2))" "${3:-$SETTLE}"
}

# Linux input-event codes. Real key events are the ONLY way to fire a
# compositor keybind — see cmd_sendkey for why send_shortcut cannot.
# code:NAME[,ALIAS...] — Linux input-event codes
KEYTABLE='125:SUPER,META,LEFTMETA,MOD 42:SHIFT,LEFTSHIFT 29:CTRL,CONTROL,LEFTCTRL
56:ALT,LEFTALT 30:A 48:B 46:C 32:D 18:E 33:F 34:G 35:H 23:I 36:J 37:K 38:L
50:M 49:N 24:O 25:P 16:Q 19:R 31:S 20:T 22:U 47:V 17:W 45:X 21:Y 44:Z 2:1
3:2 4:3 5:4 6:5 7:6 8:7 9:8 10:9 11:0 57:SPACE 15:TAB 1:ESC,ESCAPE 28:ENTER,RETURN
14:BACKSPACE 111:DELETE,DEL 53:SLASH 51:COMMA 52:PERIOD,DOT 12:MINUS 13:EQUAL
39:SEMICOLON 105:LEFT 106:RIGHT 103:UP 108:DOWN 102:HOME 107:END 104:PAGEUP,PGUP
109:PAGEDOWN,PGDN 59:F1 60:F2 61:F3 62:F4 63:F5 64:F6 65:F7 66:F8 67:F9
68:F10 87:F11 88:F12 99:PRINT,SYSRQ 164:XF86AUDIOPLAY,PLAYPAUSE 163:XF86AUDIONEXT,NEXTSONG
165:XF86AUDIOPREV,PREVIOUSSONG 166:XF86AUDIOSTOP,STOPCD 113:XF86AUDIOMUTE,MUTE
114:XF86AUDIOLOWERVOLUME,VOLUMEDOWN 115:XF86AUDIORAISEVOLUME,VOLUMEUP 248:XF86AUDIOMICMUTE,MICMUTE
224:XF86MONBRIGHTNESSDOWN,BRIGHTNESSDOWN 225:XF86MONBRIGHTNESSUP,BRIGHTNESSUP'

keycode() {
  local want entry code names name
  want="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  for entry in $KEYTABLE; do
    code="${entry%%:*}"
    names="${entry#*:}"
    for name in ${names//,/ }; do
      if [[ "$name" == "$want" ]]; then
        echo "$code"
        return 0
      fi
    done
  done
  return 1
}

# Press a real key through /dev/uinput, so it travels the compositor's input
# path and FIRES KEYBINDS. Mods are held down around the key and released in
# reverse order.
cmd_key() {
  [[ $# -ge 1 ]] || die 'key needs [MODS] KEY, e.g. key "SUPER SHIFT" B  |  key Escape'
  in_slot && slot_key "$@" && return
  need ydotool
  # `key SUPER B` and `key Escape 0.3` are both two arguments, so decide by
  # asking whether the SECOND one names a key: if it does, the first is the
  # modifier list; if it does not, it is a settle time.
  local mods key settle
  if [[ $# -ge 2 ]] && [[ -n "$1" ]] && keycode "$2" >/dev/null 2>&1; then
    mods="$1"
    key="$2"
    settle="${3:-0.6}"
  else
    mods=""
    key="$1"
    settle="${2:-0.6}"
  fi

  local code seq="" tail="" m mc
  code="$(keycode "$key")" || die "unknown key '$key' (add it to keycode() in $0)"
  for m in $mods; do
    mc="$(keycode "$m")" || die "unknown modifier '$m'"
    seq="$seq $mc:1"
    tail="$mc:0 $tail"
  done
  # shellcheck disable=SC2086
  ydotool key $seq "$code:1" "$code:0" $tail >/dev/null 2>&1 || die "ydotool key failed"
  sleep "$settle"
}

# Deliver a shortcut to the FOCUSED CLIENT only. This does NOT fire compositor
# keybinds: Hyprland injects it past its own bind processing, so a global
# shortcut bound to the same combo never runs. Verified — `sendkey SUPER SHIFT B`
# returned ok and the shell's railToggle never fired, while `key SUPER SHIFT B`
# toggled it. Use this only to send keys INTO an application.
cmd_sendkey() {
  [[ $# -ge 1 ]] || die 'sendkey needs MODS KEY (mods may be "")'
  in_slot && slot_key "$@" && return
  local mods="$1" key="${2:-}"
  if [[ -z "$key" ]]; then
    key="$mods"
    mods=""
  fi
  # `mods` is REQUIRED by hl.send_shortcut even when empty, and `key` must exist
  # in the active keymap — a key the keyboard does not have errors "key not found".
  hdisp "hl.dsp.send_shortcut({mods=\"$mods\",key=\"$key\"})"
  sleep "${3:-0.6}"
}

cmd_click() {
  in_slot && slot_click left "${3:-}" && return
  need ydotool
  ydotool click "${2:-0xC0}" >/dev/null 2>&1 || die "click failed"
  sleep "${3:-0.4}"
}
# Hold or let go of a button, so a drag is press, move, release. Mask: ydotool 0x40 down / 0x80 up | button.
cmd_press() {
  in_slot && slot_press "$@" && return
  need ydotool
  ydotool click "0x4$(($(slot_button "${1:-}") - 272))" >/dev/null 2>&1 || die "press failed"
}
cmd_release() {
  in_slot && slot_release "$@" && return
  need ydotool
  ydotool click "0x8$(($(slot_button "${1:-}") - 272))" >/dev/null 2>&1 || die "release failed"
}
cmd_rclick() {
  in_slot && slot_click right "${1:-}" && return
  need ydotool
  ydotool click 0xC1 >/dev/null 2>&1 || die "rclick failed"
  sleep "${2:-0.4}"
}
cmd_mclick() {
  in_slot && slot_click middle "${1:-}" && return
  need ydotool
  ydotool click 0xC2 >/dev/null 2>&1 || die "mclick failed"
  sleep "${2:-0.4}"
}
cmd_type() {
  in_slot && slot_type "$@" && return
  need ydotool
  ydotool type -- "$1" >/dev/null 2>&1 || die "type failed"
  sleep "${2:-0.4}"
}
cmd_scroll() {
  in_slot && slot_scroll "$@" && return
  need ydotool
  ydotool mousemove -w -x 0 -y "${1:--1}" >/dev/null 2>&1
  sleep "${2:-0.4}"
}

cmd_shot() {
  need grim
  local mon="${1:-}" name="${2:-shot}"
  mkdir -p "$OUT_DIR"
  if [[ -z "$mon" ]] || [[ "$mon" = "-" ]]; then mon="$(cmd_focused)"; fi
  grim -o "$mon" "$OUT_DIR/$name.png" || die "grim failed for output $mon"
  printf '%s\n' "$OUT_DIR/$name.png"
}

cmd_focused() {
  if in_slot; then echo "$SLOT_OUTPUT"; else hyprctl monitors -j | jq -r '.[]|select(.focused)|.name'; fi
}

# Logical size is physical/scale. Cursor moves use LOGICAL px; grim writes PHYSICAL px.
# Multiply a logical coord by scale to find it in a screenshot.
cmd_mons() {
  hyprctl monitors -j | jq -r '.[] |
    "\(.name)  physical=\(.width)x\(.height)  logical=\((.width/.scale)|floor)x\((.height/.scale)|floor)  at=\(.x),\(.y)  scale=\(.scale)  focused=\(.focused)"'
}

cmd_l2p() {
  [[ $# -ge 1 ]] || die "l2p needs LOGICAL_N [MONITOR]"
  local mon="${2:-$(cmd_focused)}"
  hyprctl monitors -j | jq -r --arg m "$mon" --argjson n "$1" \
    '.[]|select(.name==$m)|"logical \($n) -> physical \(($n*.scale)|floor) (scale \(.scale))"'
}

# Poll a shell command until it succeeds. Beats a blind sleep after an animation.
cmd_until() {
  local tries="${2:-20}" i=0
  while [[ "$i" -lt "$tries" ]]; do
    if eval "$1" >/dev/null 2>&1; then return 0; fi
    i=$((i + 1))
    sleep 0.25
  done
  die "condition never became true: $1"
}

cmd_doctor() {
  local ok=0
  chk() {
    local label="$1" fail="$2"
    shift 2
    printf '%-22s' "$label"
    if "$@" >/dev/null 2>&1; then echo OK; else
      echo "$fail"
      ok=1
    fi
  }
  in_input_group() { id -nG | tr ' ' '\n' | grep -qx input; }
  # Warps onto the current position: proves the lua dispatcher runs without moving the pointer.
  cursor_dispatch() {
    local x y
    x="$(hyprctl cursorpos -j | jq -er '.x | floor')" && y="$(hyprctl cursorpos -j | jq -er '.y | floor')" \
      && hyprctl dispatch "hl.dsp.cursor.move({x=$x,y=$y})" 2>&1 | grep -q '^ok'
  }
  keymap() { keycode SUPER && keycode XF86AudioPlay; }
  chk hyprctl MISSING command -v hyprctl
  chk 'cursor dispatch' 'FAIL (lua dialect? see USAGE.md)' cursor_dispatch
  chk 'keycode map' FAIL keymap
  chk ydotool MISSING command -v ydotool
  chk 'ydotoold running' 'NOT RUNNING (start: ydotoold &)' pgrep -x ydotoold
  chk 'input group' "NO (need: usermod -aG input \$USER + relogin)" in_input_group
  chk '/dev/uinput writable' NO test -w /dev/uinput
  chk grim MISSING command -v grim
  chk jq MISSING command -v jq
  return "$ok"
}

usage() {
  cat <<'USAGE'
drive — sudo-free computer use on Hyprland/Wayland

  POINTER (logical coords, exact)
    move X Y [settle]        move cursor to layout X,Y (real motion -- hover FIRES)
    warp X Y [settle]        compositor warp; exact but NO motion event, hover will NOT fire
    nudge DX DY [settle]     move cursor relative to where it is
    pos                      print cursor position

  INPUT (ydotool)
    click [mask] [settle]    left click (0xC0); mask overridable
    press [left|right|middle] / release   hold and let go of a button (a drag is press, move, release)
    rclick / mclick          right / middle click
    type "text" [settle]     type a literal string
    scroll [amount]          wheel; negative = down

  KEYS (real key events -- these DO fire compositor keybinds)
    key "MODS" KEY [settle]  e.g. key "SUPER SHIFT" B
    key KEY                  no modifier, e.g. key Escape
    esc                      Escape
    sendkey MODS KEY         to the FOCUSED CLIENT only; does NOT fire keybinds

  SCREEN
    shot [MON|-] [name]      grim one output ("-" = focused) -> $DRIVE_OUT_DIR
    mons                     outputs with physical AND logical size + scale
    focused                  focused output name
    l2p N [MON]              convert a logical length to physical pixels
    geom CHECK ARGS          measure the live item tree: insets overlap inside centre target dump (drive geom)
    hitmap zone|grid ARGS    hit and hover zones measured from pixels (drive hitmap)
    contrast A B             WCAG ratio between two rects/points of the live screen (drive contrast)

  SLOT (isolated headless sway per agent; add --slot NAME or DRIVE_SLOT=NAME to shot, record, frames, route, move, nudge, pos, click, rclick, mclick, type, scroll, key, sendkey, geom)
    slot start NAME [--size WxH] [--scale S]   launch a slot (default 1280x800 @1), print its display
    slot run NAME -- CMD...                    run a client inside it (QT_QPA_PLATFORM=wayland)
    slot bench NAME ROOT KEY                   start a Workbench session of story KEY in it (what geom reads)
    slot ls | slot stop NAME                   list slots with RSS | kill the whole tree, remove its files
    slot budget [--reserve-mb N] [--per-slot-mb N] [--provider ROOT] [--story KEY] [--remeasure]   slots that fit in MemAvailable (cost measured by a probe slot, cached)

  ATLAS (the whole desktop, nested and sandboxed in a desktop slot per journey)
    slot start NAME --desktop QS_PATH [--hypr LUA] [--mock FILE]   one desktop slot; FILE reaches the shell as DRIVE_MOCK (NAME <= 6 chars under /run/user/1000)
    slot aquamarine          build the Aquamarine fix a nested Hyprland needs (once, into the cache)
    atlas run SCENARIO       every journey in a fresh desktop slot; shots, trees, diff with the last run, index.html
    atlas ls                 scenarios and their kept runs

  FLOW
    until 'CMD' [tries]      poll CMD until it exits 0 (beats a blind sleep)
    record SECS [OUT|X,Y,WxH] [--fps N]  real-frame video + measured cadence (never CFR)
    frames VIDEO DIR [--every N]         extract real frames as PNGs
    route FILE [--workspace-ok]          run a step script; shots per step; pointer restored
    doctor                   check every dependency and permission

  ENV: DRIVE_OUT_DIR (default $XDG_RUNTIME_DIR/drive-shots), DRIVE_SETTLE (0.35),
       DRIVE_LIVE=1 (required for a capture or input on the owner's session outside a slot)
USAGE
}

# record, frames, route and the slot verbs live beside this file (resolved through the bin symlink).
# shellcheck source=drive-motion
MOTION_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$MOTION_DIR/drive-motion"
# shellcheck source=drive-slot
source "$MOTION_DIR/drive-slot"
# shellcheck source=drive-hitmap
source "$MOTION_DIR/drive-hitmap"
# shellcheck source=drive-atlas
source "$MOTION_DIR/drive-atlas"

# A capture or an input on the owner's session is opt-in: a screencopy cut short crashed the
# owner's Hyprland once (SIGBUS in copyShm), and an agent's stray click lands in the owner's work.
live_gate() {
  local acting=" move warp nudge record route key sendkey esc click press release rclick mclick type scroll shot contrast hitmap "
  in_slot || [[ "${DRIVE_LIVE:-}" == 1 || "$acting" != *" ${1:-none} "* ]] \
    || die "'$1' acts on the owner's live session: run it in a slot (DRIVE_SLOT=NAME), or set DRIVE_LIVE=1 when the owner asked for live input"
}

dispatch() {
  # contrast over a saved capture touches no session at all.
  [[ "${1:-}" == contrast && (" ${*:2} " == *" --shot "* || "${2:-}${3:-}" =~ ^#[0-9a-fA-F]{6}#[0-9a-fA-F]{6}$) ]] && exec "$(dirname "$(readlink -f "$0")")/contrast" "${@:2}"
  in_slot && slot_refuse "${1:-}"
  live_gate "${1:-}"
  case "${1:-}" in
    atlas | slot | move | warp | nudge | record | frames | route | key | sendkey | click | press | release | rclick | mclick | type | scroll | shot | hitmap | l2p | until)
      local verb="cmd_$1"
      shift
      "$verb" "$@"
      ;;
    esc) cmd_key Escape ;;
    pos) if in_slot; then slot_pos; else hyprctl cursorpos; fi ;;
    mons) cmd_mons ;;
    geom) exec "$(dirname "$(readlink -f "$0")")/geom" "${@:2}" ;;
    contrast) exec "$(dirname "$(readlink -f "$0")")/contrast" "${@:2}" ;;
    focused) cmd_focused ;;
    doctor) cmd_doctor ;;
    *) usage ;;
  esac
}

slot_select "$@"
dispatch "${SLOT_ARGV[@]}"
