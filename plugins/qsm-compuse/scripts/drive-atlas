# shellcheck shell=bash disable=SC2154 # SLOT_* come from the slot state file, MOTION_DIR from drive
# Sourced by drive: the atlas verbs. A scenario names a desktop and its journeys; every journey
# runs in a fresh desktop slot, every `shot` step writes the screen and its item tree, and each
# run is kept beside the earlier ones and compared with the one before it, shot by shot.
#
# Scenario, one directive per line ('#' starts a comment, ~ is the home directory):
#   desktop PATH            the shell's Quickshell path (required)
#   hypr FILE               the Hyprland lua config the nested desktop reads
#   clock YYYY-MM-DD HH:MM:SS   a fixed wall clock, handed to the shell as DRIVE_CLOCK
#   fixtures DIR            recorded readings the shell shows instead of live ones (DRIVE_FIXTURES)
#   settle SECONDS          the pause after each step (default 0.6)
#   journey NAME            starts a journey; the steps below belong to it
# Steps: the route steps (move-to X Y, hover-wait MS, press, release, click, key COMBO, wheel DY),
# plus type TEXT, exec CMD (a client started by the nested Hyprland), dispatch LUA, eval LUA (a
# config call such as a window rule), wait-clients N,
# ipc FN ARGS (the shell's own IPC: open a surface, post mock data),
# shot NAME (taken once the screen is still), shot-now NAME (taken at once, for a state that times out).
#
# A run is <scenario>/<date>-<time>-<rng>/: index.html (everything on one page), shots/ (the
# captures as taken), trees/ (the item tree of each shot), diff-<run>/ (a comparison with that run).

ATLAS_ROOT="${DRIVE_ATLAS_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/qsm/compuse/atlas}"
# A changed pixel differs by more than this share in one channel; a changed area is a connected
# region of at least this many pixels. Below both lies GPU noise.
ATLAS_FUZZ="${DRIVE_ATLAS_FUZZ:-3}"
ATLAS_MIN_AREA="${DRIVE_ATLAS_MIN_AREA:-16}"

atlas_path() { printf '%s\n' "${1/#\~/$HOME}"; }

# The scenario's settings as NAME=VALUE lines; journeys stay in the file.
atlas_settings() {
  awk '$1 ~ /^(desktop|hypr|clock|fixtures|settle)$/ { k = $1; $1 = ""; sub(/^ /, ""); print k "=" $0 }' "$1"
}

# The steps of one journey, without indentation or comments.
atlas_steps() {
  awk -v j="$2" '
    /^[ \t]*(#|$)/ { next }
    $1 == "journey" { on = ($2 == j); next }
    on { sub(/^[ \t]+/, ""); print }' "$1"
}

atlas_journeys() { awk '$1 == "journey" { print $2 }' "$1"; }

# ipc FN ARGS: a call into the shell's `qsm` IPC target, so a scenario opens a surface or posts
# mock data directly (a look and feel check, not a functional one). Quoted args keep their spaces.
atlas_ipc() {
  local split
  local -a args
  split="$(xargs -n1 printf '%s\n' <<<"$2" 2>&1)" || die "ipc arguments do not parse (an unmatched quote?): $2"
  mapfile -t args <<<"$split"
  (slot_run "$1" -- qs ipc --path "$SLOT_QS_PATH" call qsm "${args[@]}") >/dev/null || die "ipc failed: $2"
}

# wait-clients N: until the nested Hyprland maps exactly N windows (10 s at most).
atlas_wait_clients() {
  local i
  [[ "$2" =~ ^[0-9]+$ ]] || die "wait-clients needs a count"
  for ((i = 0; i < 40; i++)); do
    [[ "$( (slot_run "$1" -- hyprctl clients -j) | jq length)" == "$2" ]] && return
    sleep 0.25
  done
  die "the nested desktop never reached $2 windows"
}

# Waits until the shell answers its inspect call with a tree, so the first shot sees a loaded desktop.
atlas_wait_shell() {
  local i
  for ((i = 0; i < 60; i++)); do
    # A subshell: slot_tree dies (exits) while the shell is still loading.
    (slot_tree "$1") >/dev/null 2>&1 && return
    sleep 0.25
  done
  die "the shell in slot '$1' never answered (see $(slot_dir "$1")/qs.log)"
}

# Shoots OUT once two captures 150 ms apart show no changed area, so a shot never lands mid-animation;
# the last capture is the shot. A screen that never stills (a looping animation) is shot after 5 s
# and marked moving.
atlas_still() {
  local out="$1" a="$1.still.png" i
  grim -o "$SLOT_OUTPUT" "$a" || die "grim failed in the atlas slot"
  for ((i = 0; i < 33; i++)); do
    sleep 0.15
    grim -o "$SLOT_OUTPUT" "$out" || die "grim failed in the atlas slot"
    if [[ -z "$(atlas_areas "$a" "$out")" ]]; then
      rm -f "$a"
      echo still
      return
    fi
    command mv -f "$out" "$a"
  done
  command mv -f "$a" "$out"
  echo moving
}

# hyprctl exits 0 when the lua of a dispatch or eval fails and prints the error, so its output decides.
atlas_hyprctl() {
  [[ "$( (slot_run "$1" -- hyprctl "$2" "$3") 2>&1)" == ok ]] || die "$2 failed: $3"
}

atlas_step() {
  local slot="$1" line="$2" verb a b rest
  read -r verb a b rest <<<"$line"
  case "$verb" in
    type) slot_type "${line#type }" 0 ;;
    exec)
      [[ "$line" != *"]]"* ]] || die "an exec command must not hold ']]' (it is a lua long string): $line"
      atlas_hyprctl "$slot" dispatch "hl.dsp.exec_cmd([[${line#exec }]])"
      ;;
    dispatch) atlas_hyprctl "$slot" dispatch "${line#dispatch }" ;;
    eval) atlas_hyprctl "$slot" eval "${line#eval }" ;;
    wait-clients) atlas_wait_clients "$slot" "$a" ;;
    ipc) atlas_ipc "$slot" "${line#ipc }" ;;
    *) route_step "$verb" "$a" "$b" "$rest" || die "unknown atlas step '$line'" ;;
  esac
}

# One journey in a fresh desktop slot; prints "journey<TAB>shot<TAB>step<TAB>still" per shot.
atlas_journey() {
  local scenario="$1" journey="$2" run="$3" slot="$4" settle="$5" n line name still
  local -a steps
  shift 5
  slot_start "$slot" "$@" >/dev/null
  export DRIVE_SLOT="$slot"
  slot_load "$slot"
  atlas_wait_shell "$slot"
  sleep 1
  mapfile -t steps < <(atlas_steps "$scenario" "$journey")
  for ((n = 0; n < ${#steps[@]}; n++)); do
    line="${steps[n]}"
    if [[ "$line" == shot\ * || "$line" == shot-now\ * ]]; then
      name="$journey--${line#* }"
      [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "shot names are letters, digits, dot, dash and underscore: '$name'"
      # shot-now catches a state that times out (an armed button), so it waits for nothing.
      if [[ "$line" == shot-now\ * ]]; then
        OUT_DIR="$run/shots" cmd_shot - "$name" >/dev/null
        still=now
      else
        still="$(atlas_still "$run/shots/$name.png")" || exit 1
      fi
      slot_tree "$slot" >"$run/trees/$name.json"
      printf '%s\t%s\t%s\t%s\n' "$journey" "${line#* }" "$((n + 1))" "$still"
    else
      atlas_step "$slot" "$line"
      # A step right before shot-now gets no settle, or the state it caught is already gone.
      [[ "${steps[n + 1]:-}" == shot-now\ * ]] || sleep "$settle"
    fi
  done
  slot_kill "$slot"
  unset DRIVE_SLOT
}

# A run is built under a dot name and renamed when it completes, so a failed run is never a baseline.
atlas_run() {
  local scenario="${1:-}" desktop="" hypr="" clock="" fixtures="" settle=0.6 opt dir id run slot journey prev
  local -a start
  [[ -f "$scenario" ]] || die "atlas run needs a SCENARIO file"
  while IFS= read -r opt; do printf -v "${opt%%=*}" '%s' "${opt#*=}"; done < <(atlas_settings "$scenario")
  desktop="$(atlas_path "$desktop")"
  hypr="$(atlas_path "$hypr")"
  fixtures="$(atlas_path "$fixtures")"
  [[ -n "$desktop" ]] || die "the scenario names no desktop"
  [[ -n "$(atlas_journeys "$scenario")" ]] || die "the scenario has no journey"
  dir="$ATLAS_ROOT/$(basename "${scenario%.*}")"
  prev="$(atlas_runs "$dir" | tail -1)"
  id="$(date +%Y%m%d-%H%M%S)-$(printf '%04x' "$RANDOM")"
  run="$dir/.$id"
  mkdir -p "$run/shots" "$run/trees"
  command cp "$scenario" "$run/scenario"
  printf '%s\n' "$(git -C "$desktop" describe --always --dirty 2>/dev/null || echo unknown)" >"$run/desktop-version"
  slot="at$((RANDOM % 100000))"
  start=(--desktop "$desktop")
  [[ -z "$hypr" ]] || start+=(--hypr "$hypr")
  [[ -z "$clock" ]] || start+=(--clock "$clock")
  [[ -z "$fixtures" ]] || start+=(--fixtures "$fixtures")
  trap 'slot_kill "'"$slot"'" 2>/dev/null; rm -rf "'"$run"'"' EXIT
  for journey in $(atlas_journeys "$scenario"); do
    printf 'journey %s\n' "$journey" >&2
    atlas_journey "$scenario" "$journey" "$run" "$slot" "$settle" "${start[@]}" >>"$run/shots.tsv"
  done
  trap - EXIT
  command mv "$run" "$dir/$id"
  run="$dir/$id"
  if [[ -n "$prev" ]]; then atlas_compare "$dir/$prev" "$run"; fi
  atlas_report "$run" "$prev"
  printf '%s/index.html\n' "$run"
}

# The completed runs of one scenario dir, oldest first.
atlas_runs() { find "$1" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' -printf '%f\n' 2>/dev/null | sort; }

# The changed areas of one shot: "x y w h" per connected region over the noise floor.
atlas_areas() {
  magick "$1" "$2" -compose difference -composite -separate -evaluate-sequence max \
    -threshold "$ATLAS_FUZZ%" -define connected-components:verbose=true \
    -define connected-components:area-threshold="$ATLAS_MIN_AREA" -connected-components 8 null: \
    | awk '/gray\(255\)|#FFFFFF|white/ { split($2, g, /[x+]/); print g[3], g[4], g[1], g[2] }'
}

# Every item as "path<TAB>x y w h", the path built from types and same-type sibling indices.
atlas_items() {
  jq -r 'def items($p): [$p, .x, .y, .w, .h], ((.children // []) as $k
      | [range(0; $k | length)] | map(. as $i | $k[$i] + {_n: ([$k[:$i][] | select(.type == $k[$i].type)] | length)})[]
      | items($p + "/" + .type + "[" + (._n | tostring) + "]"));
    .tree | items(.type) | "\(.[0])\t\(.[1] | round) \(.[2] | round) \(.[3] | round) \(.[4] | round)"' "$1" \
    || die "not an item tree: $1"
}

# Run B against run A, per shot both hold, into B/diff-<A>/: the overlay of a changed shot
# (NAME.png), its changed areas (NAME.areas), the items that moved, appeared or went (NAME.items),
# and summary.tsv (name, areas, items).
atlas_compare() {
  local a="$1" b="$2" out png name areas moved
  out="$b/diff-$(basename "$a")"
  rm -rf "$out"
  mkdir -p "$out"
  for png in "$b"/shots/*.png; do
    name="$(basename "$png" .png)"
    [[ -f "$a/shots/$name.png" ]] || continue
    areas="$(atlas_areas "$a/shots/$name.png" "$png" | tee "$out/$name.areas" | wc -l)"
    if ((areas > 0)); then
      magick "$png" \( "$a/shots/$name.png" "$png" -compose difference -composite -separate -evaluate-sequence max \
        -threshold "$ATLAS_FUZZ%" -fill '#ff3df0' -opaque white -transparent black \) -compose over -composite "$out/$name.png"
    fi
    moved="$(join -t $'\t' -a1 -a2 -e GONE -o 0,1.2,2.2 <(atlas_items "$a/trees/$name.json" | sort) <(atlas_items "$b/trees/$name.json" | sort) \
      | awk -F'\t' '$2 != $3' | tee "$out/$name.items" | wc -l)"
    printf '%s\t%s\t%s\n' "$name" "$areas" "$moved" >>"$out/summary.tsv"
  done
}

# atlas diff RUN [AGAINST]: compare any two kept runs (paths); AGAINST defaults to the run before RUN.
atlas_diff() {
  local run="${1%/}" against="${2%/}" prev
  [[ -f "$run/shots.tsv" ]] || die "atlas diff needs a RUN dir (one with shots.tsv)"
  if [[ -z "$against" ]]; then
    prev="$(atlas_runs "$(dirname "$run")" | awk -v r="$(basename "$run")" '$0 == r { print p; exit } { p = $0 }')"
    [[ -n "$prev" ]] || die "no run before $(basename "$run") to compare with"
    against="$(dirname "$run")/$prev"
  fi
  [[ -f "$against/shots.tsv" ]] || die "AGAINST '$against' is not a run dir"
  atlas_compare "$against" "$run"
  atlas_report "$run" "$(basename "$against")"
  printf '%s/index.html\n' "$run"
}

cmd_atlas() {
  local verb="${1:-}" d
  shift || true
  case "$verb" in
    run) atlas_run "$@" ;;
    diff) atlas_diff "$@" ;;
    ls) for d in "$ATLAS_ROOT"/*/; do [[ -d "$d" ]] && printf '%s %s\n' "$(basename "$d")" "$(atlas_runs "$d" | tr '\n' ' ')"; done ;;
    *) die "atlas needs run SCENARIO | diff RUN [AGAINST] | ls" ;;
  esac
}

atlas_html() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# One page per run: every shot by journey, its changed areas and items against the run it was compared with.
atlas_report() {
  local run="$1" against="${2:-}" diff="" journey shot step still name img areas moved last=""
  [[ -z "$against" ]] || diff="diff-$against"
  {
    cat <<HTML
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Atlas $(basename "$(dirname "$run")")</title><style>
:root{--bg:#120d1c;--card:#1d1629;--line:#2c2340;--text:#ece6f6;--muted:#a99cbf;--accent:#c5a5e9;--change:#ff3df0}
body{margin:0;padding:24px 16px;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,sans-serif}
main{max-width:1280px;margin:0 auto}h1{font-size:22px;margin:0 0 4px}h2{font-size:17px;margin:32px 0 12px;color:var(--accent)}
p{margin:0;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:16px}
figure{margin:0;background:var(--card);border-radius:12px;overflow:hidden}figure img{display:block;width:100%;height:auto}
figcaption{padding:10px 12px;display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline}figcaption b{font-weight:600}
.same{color:var(--muted)}.changed{color:var(--change);font-weight:600}a{color:var(--accent)}
details{padding:0 12px 10px;color:var(--muted);font-size:13px}pre{white-space:pre-wrap;margin:6px 0 0}
</style></head><body><main>
<h1>Atlas $(basename "$(dirname "$run")") · $(basename "$run")</h1>
<p>desktop $(atlas_html <"$run/desktop-version") · $(if [[ -n "$against" ]]; then printf 'compared with %s' "$against"; else printf 'first run, nothing to compare'; fi)</p>
HTML
    while IFS=$'\t' read -r journey shot step still; do
      [[ "$journey" == "$last" ]] || { [[ -z "$last" ]] || echo '</div>'; printf '<h2>%s</h2><div class="grid">\n' "$journey"; last="$journey"; }
      name="$journey--$shot"
      areas="" moved=""
      [[ -z "$diff" ]] || read -r areas moved < <(awk -F'\t' -v n="$name" '$1 == n { print $2, $3 }' "$run/$diff/summary.tsv" 2>/dev/null)
      img="shots/$name.png"
      [[ -z "$diff" || ! -f "$run/$diff/$name.png" ]] || img="$diff/$name.png"
      printf '<figure><a href="shots/%s.png"><img src="%s" alt="%s"></a><figcaption><b>%s</b><span class="same">step %s</span>' \
        "$name" "$img" "$shot" "$shot" "$step"
      [[ "$still" != moving ]] || printf '<span class="changed">never still</span>'
      if [[ -z "$areas" ]]; then printf '<span class="same">new</span>'
      elif ((areas == 0 && moved == 0)); then printf '<span class="same">unchanged</span>'
      else printf '<span class="changed">areas changed: %s · items changed: %s</span>' "$areas" "$moved"; fi
      printf '</figcaption>'
      printf '<details><summary>surfaces</summary><pre>%s</pre></details>' \
        "$(GEOM_TREE="$run/trees/$name.json" "$MOTION_DIR/geom" dump --depth 3 | atlas_html)"
      if [[ -n "$diff" && -s "$run/$diff/$name.areas" ]]; then
        printf '<details><summary>changed areas (x y w h, device px)</summary><pre>%s</pre></details>' "$(head -40 "$run/$diff/$name.areas" | atlas_html)"
      fi
      if [[ -n "$diff" && -s "$run/$diff/$name.items" ]]; then
        printf '<details><summary>items that moved, appeared or went (before, after)</summary><pre>%s</pre></details>' "$(head -40 "$run/$diff/$name.items" | atlas_html)"
      fi
      printf '</figure>\n'
    done <"$run/shots.tsv"
    printf '</div></main></body></html>\n'
  } >"$run/index.html"
}
