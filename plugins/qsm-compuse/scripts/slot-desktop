#!/usr/bin/env bash
# Runs INSIDE the desktop slot's sandbox (drive-slot starts it under bwrap with only the
# render node in /dev/dri): headless sway -> niri (winit) -> nested Hyprland -> the shell.
# sway and weston are too old a parent for Aquamarine (xdg_wm_base 5, wl_compositor 5);
# niri speaks 6, and the outer sway gives the stack a capturable output and an input seat.
#   slot-desktop DIR QS_PATH   (DIR holds sway.conf, niri.kdl, hyprland.lua; logs go there)
set -u
dir="$1"
qs_path="$2"
rt="${XDG_RUNTIME_DIR:?}"
sig=""
export LIBSEAT_BACKEND=noop XDG_STATE_HOME="$dir/xdg-state" XDG_CACHE_HOME="$dir/xdg-cache" XDG_DATA_HOME="$dir/xdg-data"
mkdir -p "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"

# One session bus for the whole slot, at a path the host reaches too: sway, niri, Hyprland, every
# client Hyprland starts and the shell share it, so a real client (notify-send) reaches the shell.
dbus-daemon --session --nofork --nopidfile --address="unix:path=$rt/bus" >"$dir/dbus.log" 2>&1 &
for ((i = 0; i < 50; i++)); do
  [[ -S "$rt/bus" ]] && break
  sleep 0.1
done
[[ -S "$rt/bus" ]] || exit 2
export DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus"

# The fake machine: with a mock, its readings are the slot's state (DRIVE_STATE, a copy the `mock`
# step changes during a run), and the tools in shims/ answer from it ahead of the real ones on PATH,
# for every process in the slot.
if [[ -n "${DRIVE_MOCK:-}" ]]; then
  cp "$DRIVE_MOCK" "$dir/state.json"
  export DRIVE_STATE="$dir/state.json" PATH="${0%/*}/shims:$PATH"
fi

WLR_BACKENDS=headless WLR_RENDERER=gles2 WLR_RENDER_DRM_DEVICE="${DRIVE_RENDER_NODE:?}" WLR_LIBINPUT_NO_DEVICES=1 \
  sway -c "$dir/sway.conf" >"$dir/sway.log" 2>&1 &
for ((i = 0; i < 50; i++)); do
  [[ -s "$dir/display" ]] && break
  sleep 0.2
done
[[ -s "$dir/display" ]] || exit 3

# DRIVE_AQUAMARINE is empty when the installed library is fixed (see slot_aquamarine_lib in drive-slot).
WAYLAND_DISPLAY="$(cat "$dir/display")" niri -c "$dir/niri.kdl" -- \
  env ${DRIVE_AQUAMARINE:+LD_LIBRARY_PATH="$DRIVE_AQUAMARINE"} start-hyprland -- --config "$dir/hyprland.lua" >"$dir/niri.log" 2>&1 &
for ((i = 0; i < 100; i++)); do
  sig="$(find "$rt/hypr" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | head -1)"
  [[ -n "$sig" && -s "$rt/hypr/$sig/hyprland.lock" && -S "$rt/hypr/$sig/.socket.sock" ]] && break
  sleep 0.2
done
[[ -S "$rt/hypr/$sig/.socket.sock" ]] || exit 4
printf 'SLOT_HYPR_SIG=%s\nSLOT_CLIENT_DISPLAY=%s\n' "$sig" "$(sed -n 2p "$rt/hypr/$sig/hyprland.lock")" >"$dir/inner"

WAYLAND_DISPLAY="$(sed -n 2p "$rt/hypr/$sig/hyprland.lock")"
export WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE="$sig" QT_QPA_PLATFORM=wayland XDG_CURRENT_DESKTOP=Hyprland QS_DISABLE_CRASH_HANDLER=1
# The shell gets the owner's config with the owner's Qt theme (qt6ct), except that the text caret
# never blinks, so a shot of a focused field is the same on every run: a config dir of links to
# the owner's, with qt6ct's own file copied and cursor_flash_time=0 in it.
home_cfg="$HOME/.config"
cfg="$dir/xdg-config"
mkdir -p "$cfg/qt6ct"
for entry in "$home_cfg"/* "$home_cfg"/.[!.]*; do
  [[ -e "$entry" && "$entry" != "$home_cfg/qt6ct" ]] && ln -sfn "$entry" "$cfg/${entry##*/}"
done
for entry in "$home_cfg"/qt6ct/*; do
  [[ -e "$entry" && "$entry" != */qt6ct.conf ]] && ln -sfn "$entry" "$cfg/qt6ct/${entry##*/}"
done
awk '/^cursor_flash_time=/ { next } { print } /^\[Interface\]$/ { print "cursor_flash_time=0"; done = 1 }
  END { if (!done) print "[Interface]\ncursor_flash_time=0" }' "$home_cfg/qt6ct/qt6ct.conf" 2>/dev/null >"$cfg/qt6ct/qt6ct.conf"
# DRIVE_MOCK is the JSON file of recorded readings the desktop shows instead of live ones (see
# USAGE.md), empty when the slot has none. DRIVE_FAKETIME is set when the mock names a clock and
# hyprlock exists: the shell then finds a hyprlock on its PATH that shows that clock (DRIVE_CLOCK).
if [[ -n "${DRIVE_FAKETIME:-}" ]]; then
  mkdir -p "$dir/bin"
  printf '#!/bin/sh\nLD_PRELOAD=%s FAKETIME="@%s" FAKETIME_DONT_FAKE_MONOTONIC=1 exec /usr/bin/hyprlock "$@"\n' "$DRIVE_FAKETIME" "${DRIVE_CLOCK:?}" >"$dir/bin/hyprlock"
  chmod +x "$dir/bin/hyprlock"
  PATH="$dir/bin:$PATH"
fi
XDG_CONFIG_HOME="$cfg" QT_QPA_PLATFORMTHEME=qt6ct qs --path "$qs_path" >"$dir/qs.log" 2>&1 &
wait
