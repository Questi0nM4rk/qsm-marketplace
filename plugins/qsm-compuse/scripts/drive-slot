#!/usr/bin/env bash
# shellcheck disable=SC2154,SC2153 # SLOT_* come from the state file sourced by slot_load
# Sourced by drive: the slot verbs, and the slot forms of pointer, keys and tree.
# A slot is one headless sway with its own Wayland socket and its own virtual pointer
# and keyboard. sway, not cage, because cage has no way to set the output size or scale.
# Every process started in a slot carries DRIVE_SLOT_ID=<dir>, so the whole tree is
# found by environment even after a client detaches from its parent.

SLOT_ROOT="${DRIVE_SLOT_DIR:-${XDG_RUNTIME_DIR:-/tmp}/drive-slots}"
# Aquamarine's wayland backend names the nested Hyprland's one output.
SLOT_NESTED_OUTPUT=WAYLAND-1
in_slot() { [[ -n "${DRIVE_SLOT:-}" ]]; }
slot_dir() { printf '%s/%s\n' "$SLOT_ROOT" "$1"; }

# sway marks itself non-dumpable, so its environ is unreadable: it is listed by its pid file, its clients by the marker.
slot_pids() {
  cat "$(slot_dir "$1")/pid" 2>/dev/null
  grep -alxFz "DRIVE_SLOT_ID=$(slot_dir "$1")" /proc/[0-9]*/environ 2>/dev/null | sed 's|/proc/\([0-9]*\)/environ|\1|'
}

slot_field() { sed -n "s/^$2=//p" "$(slot_dir "$1")/state"; }
slot_alive() { [[ -f "$(slot_dir "$1")/state" ]] && kill -0 "$(slot_field "$1" SLOT_PID)" 2>/dev/null; }

# Fills the SLOT_* variables and the wayland env of the current process.
slot_load() {
  slot_alive "$1" || die "slot '$1' is not running (drive slot start $1)"
  # shellcheck disable=SC1090,SC1091
  source "$(slot_dir "$1")/state"
  DRIVE_SLOT_ID="$(slot_dir "$1")"
  # A desktop slot's sockets live in its own runtime dir and are named by absolute path (libwayland's own
  # rule), so the session's XDG_RUNTIME_DIR stays and a nested drive still finds the slot.
  export WAYLAND_DISPLAY="${SLOT_RT:+$SLOT_RT/}$SLOT_DISPLAY" SWAYSOCK="$SLOT_SWAYSOCK" DRIVE_SLOT_ID
  # Keys go where a client's keyboard is: in a desktop slot the nested Hyprland, because niri reads
  # keycodes with its own keymap and wtype's per-device keymap would arrive as other letters.
  SLOT_KEYBOARD="${SLOT_CLIENT_DISPLAY:+$SLOT_RT/$SLOT_CLIENT_DISPLAY}"
  SLOT_KEYBOARD="${SLOT_KEYBOARD:-$WAYLAND_DISPLAY}"
}

# The name of the one output a headless sway publishes, read through its IPC socket.
slot_output_name() {
  local outputs
  outputs="$(SWAYSOCK="$1" swaymsg -t get_outputs)" || die "could not read the slot output"
  jq -r '.[0].name' <<<"$outputs"
}

# First render node that is not nvidia: the iGPU renders a headless slot, the dGPU stays asleep.
slot_render_node() {
  local node
  for node in /sys/class/drm/renderD*; do
    [[ "$(basename "$(readlink -f "$node/device/driver")")" != nvidia ]] && printf '/dev/dri/%s\n' "$(basename "$node")" && return
  done
}

slot_write_config() {
  local dir="$1" size="$2" scale="$3"
  cat >"$dir/sway.conf" <<CFG
xwayland disable
default_border none
output * resolution $size scale $scale
exec sh -c 'echo \$WAYLAND_DISPLAY > "$dir/display"'
CFG
}

# Starts sway with the given renderer; succeeds when it published its display.
slot_launch() {
  local dir="$1" renderer="$2" node="$3" i
  rm -f "$dir/display"
  env -u WAYLAND_DISPLAY -u DISPLAY -u HYPRLAND_INSTANCE_SIGNATURE -u SWAYSOCK \
    WLR_BACKENDS=headless WLR_RENDERER="$renderer" WLR_LIBINPUT_NO_DEVICES=1 \
    ${node:+WLR_RENDER_DRM_DEVICE="$node"} DRIVE_SLOT_ID="$dir" \
    setsid sway -c "$dir/sway.conf" </dev/null >"$dir/sway.log" 2>&1 &
  echo $! >"$dir/pid"
  for ((i = 0; i < 50; i++)); do
    [[ -s "$dir/display" ]] && return 0
    kill -0 "$(cat "$dir/pid")" 2>/dev/null || return 1
    sleep 0.2
  done
  return 1
}

slot_publish() {
  local dir="$1" size="$2" scale="$3" renderer="$4" pid sock out
  pid="$(cat "$dir/pid")"
  sock="$XDG_RUNTIME_DIR/sway-ipc.$(id -u).$pid.sock"
  out="$(slot_output_name "$sock")" || exit 1
  printf 'SLOT_PID=%s\nSLOT_DISPLAY=%s\nSLOT_SWAYSOCK=%s\nSLOT_OUTPUT=%s\nSLOT_SIZE=%s\nSLOT_SCALE=%s\nSLOT_RENDERER=%s\n' \
    "$pid" "$(cat "$dir/display")" "$sock" "$out" "$size" "$scale" "$renderer" >"$dir/state"
  printf '0 0\n' >"$dir/pos"
}

# Keeps one virtual pointer and keyboard on the seat: a headless sway advertises neither without a device.
slot_hold() {
  need bun
  local log i
  log="$(slot_dir "$1")/holder.log"
  mkfifo "$(slot_dir "$1")/ctl" || die "could not create the control FIFO"
  # The whole subshell is detached from the caller's stdio: a backgrounded list keeps
  # the caller's pipe open for as long as the holder lives.
  (slot_load "$1" && exec setsid bun "$MOTION_DIR/slot-holder.ts") </dev/null >"$log" 2>&1 &
  for ((i = 0; i < 25; i++)); do
    grep -q holding "$log" 2>/dev/null && return 0
    sleep 0.2
  done
  die "slot input holder did not start (see $log)"
}

slot_start_args() {
  while (($#)); do
    case "$1" in
      --size) printf 'size=%s\n' "${2:?--size needs WxH}" && shift 2 ;;
      --scale) printf 'scale=%s\n' "${2:?--scale needs a number}" && shift 2 ;;
      --desktop) printf 'desktop=%s\n' "${2:?--desktop needs the Quickshell path of the shell}" && shift 2 ;;
      --hypr) printf 'hypr=%s\n' "${2:?--hypr needs a Hyprland lua config}" && shift 2 ;;
      --clock) printf 'clock=%s\n' "${2:?--clock needs a time like 2026-10-22 10:00:00}" && shift 2 ;;
      --fixtures) printf 'fixtures=%s\n' "${2:?--fixtures needs a directory of recorded readings}" && shift 2 ;;
      *) die "slot start: unknown option '$1'" ;;
    esac
  done
}

slot_start() {
  local name="${1:-}" size="" scale="" desktop="" hypr="" clock="" fixtures="" dir renderer=gles2 opt
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slot start needs NAME (lowercase letters, digits, dashes)"
  shift
  while read -r opt; do
    [[ -z "$opt" ]] || printf -v "${opt%%=*}" '%s' "${opt#*=}"
  done < <(slot_start_args "$@")
  if [[ -n "$desktop" ]]; then
    slot_start_desktop "$name" "${size:-1920x1080}" "${scale:-1.25}" "$desktop" "$hypr" "$clock" "$fixtures"
    return
  fi
  [[ -z "$hypr$clock$fixtures" ]] || die "--hypr, --clock and --fixtures need --desktop"
  size="${size:-1280x800}" scale="${scale:-1}"
  [[ "$size" =~ ^[0-9]+x[0-9]+$ && "$scale" =~ ^[0-9.]+$ ]] || die "--size must be WxH and --scale a number"
  need sway
  need swaymsg
  slot_alive "$name" && die "slot '$name' is already running"
  dir="$(slot_dir "$name")"
  rm -rf "${SLOT_ROOT:?}/${name:?}"
  mkdir -p "$dir"
  slot_write_config "$dir" "$size" "$scale"
  if ! slot_launch "$dir" gles2 "$(slot_render_node)"; then
    printf 'drive: gles2 failed in slot %s, falling back to pixman\n' "$name" >&2
    slot_kill "$name"
    renderer=pixman
    slot_launch "$dir" pixman "" || die "sway did not start in slot '$name' (see $dir/sway.log)"
  fi
  slot_publish "$dir" "$size" "$scale" "$renderer"
  slot_hold "$name"
  printf 'slot %s: display=%s output=%s size=%s scale=%s renderer=%s pid=%s\n' "$name" "$(cat "$dir/display")" \
    "$(slot_field "$name" SLOT_OUTPUT)" "$size" "$scale" "$renderer" "$(cat "$dir/pid")"
}

# ---- desktop slot: a whole Hyprland desktop, nested and sandboxed ----

# The nested Hyprland's socket path is XDG_RUNTIME_DIR/hypr/<61-char signature>/.socket2.sock, and a
# Unix socket path holds 107 bytes: the runtime dir is $XDG_RUNTIME_DIR/ds-NAME, so NAME is short.
slot_desktop_rt() { printf '%s/ds-%s\n' "${XDG_RUNTIME_DIR:?}" "$1"; }

# The nested Hyprland reads the consumer's lua config (its rules, animations, binds) with every
# process start stubbed out, because drive starts the shell itself and nothing else may run.
slot_write_desktop_config() {
  local dir="$1" size="$2" scale="$3" hypr="$4" inside="$5"
  cat >"$dir/sway.conf" <<CFG
xwayland disable
default_border none
seat * hide_cursor 1
output * resolution $size scale 1
exec sh -c 'echo \$WAYLAND_DISPLAY > "$inside/display"'
CFG
  cat >"$dir/niri.kdl" <<'CFG'
prefer-no-csd
hotkey-overlay {
    skip-at-startup
}
output "winit" {
    scale 1
}
layout {
    gaps 0
    border {
        off
    }
    focus-ring {
        off
    }
}
window-rule {
    open-fullscreen true
}
animations {
    off
}
CFG
  {
    printf -- '-- drive desktop slot: the consumer config with process starts stubbed, then the nested output.\n'
    printf 'hl.exec_cmd = function() end\n'
    [[ -z "$hypr" ]] || printf 'dofile("%s")\n' "$hypr"
    printf 'hl.monitor({ output = "%s", mode = "%s", position = "0x0", scale = %s })\n' "$SLOT_NESTED_OUTPUT" "$size" "$scale"
    printf 'hl.config({ misc = { disable_hyprland_logo = true, disable_splash_rendering = true }, debug = { disable_logs = false } })\n'
    # Binds resolve a keycode through the configured layout, and wtype's keycodes are its own: resolve by its keysym.
    printf 'hl.device({ name = "hl-virtual-keyboard-unknown", resolve_binds_by_sym = true })\n'
  } >"$dir/hyprland.lua"
}

# Aquamarine up to 0.15.1 can attach the first buffer before it acks the initial configure, and
# niri then drops the nested Hyprland, so its window never maps (upstream 7bb8bdf fixes it). Until a
# release carries the fix, the nested Hyprland loads a build of that commit from the cache.
AQUAMARINE_FIX=7bb8bdf4e8fedaf4dfae58512bc4c728671727df
slot_aquamarine_dir() { printf '%s/qsm/compuse/aquamarine-%s\n' "${XDG_CACHE_HOME:-$HOME/.cache}" "${AQUAMARINE_FIX:0:7}"; }

# The library dir the nested Hyprland must load, or nothing when the installed Aquamarine is fixed.
slot_aquamarine_lib() {
  local have
  have="$(pkg-config --modversion aquamarine)" || die "aquamarine is not installed"
  [[ "$have" != 0.15.1 && "$(printf '0.15.1\n%s\n' "$have" | sort -V | tail -1)" == "$have" ]] && return
  [[ -f "$(slot_aquamarine_dir)/libaquamarine.so.$have" ]] \
    || die "aquamarine $have cannot host a nested Hyprland under niri; build the fixed one once: drive slot aquamarine"
  slot_aquamarine_dir
}

# Builds Aquamarine at the fix commit into the cache; the build tree is removed after.
slot_aquamarine() {
  local out src tool
  for tool in git cmake hyprwayland-scanner; do need "$tool"; done
  out="$(slot_aquamarine_dir)"
  src="$(mktemp -d)"
  trap 'rm -rf "$src"; trap - RETURN' RETURN
  if ! { git -C "$src" init -q && git -C "$src" fetch -q --depth 1 https://github.com/hyprwm/aquamarine.git "$AQUAMARINE_FIX" \
    && git -C "$src" checkout -q FETCH_HEAD; }; then
    rm -rf "$src"
    die "could not fetch aquamarine $AQUAMARINE_FIX"
  fi
  if ! { cmake -S "$src" -B "$src/build" -DCMAKE_BUILD_TYPE=Release && cmake --build "$src/build" -j"$(nproc)" --target aquamarine; } >"$src/build.log" 2>&1; then
    local log
    log="$(tail -5 "$src/build.log")"
    rm -rf "$src"
    die "aquamarine build failed: $log"
  fi
  mkdir -p "$out"
  command cp -a "$src"/build/libaquamarine.so* "$out/"
  printf 'aquamarine %s built into %s\n' "${AQUAMARINE_FIX:0:7}" "$out"
}

# Only the render node exists in the sandbox's /dev, so the nested Aquamarine cannot open a card:
# with a card node it started a DRM backend on the real panel. /run is empty (no system bus,
# no logind seat) and the root is read-only, so nothing in it reaches the owner's session.
slot_start_desktop() {
  local name="$1" size="$2" scale="$3" qs_path="$4" hypr="$5" clock="$6" fixtures="$7" dir rt node aq i inside=/run/drive-slot
  ((${#name} <= 8)) || die "a desktop slot NAME has at most 8 characters (socket path limit)"
  [[ "$size" =~ ^[0-9]+x[0-9]+$ && "$scale" =~ ^[0-9.]+$ ]] || die "--size must be WxH and --scale a number"
  [[ -d "$qs_path" ]] || die "--desktop '$qs_path' is not a directory"
  [[ -z "$hypr" || -f "$hypr" ]] || die "--hypr '$hypr' does not exist"
  [[ -z "$fixtures" || -d "$fixtures" ]] || die "--fixtures '$fixtures' is not a directory"
  # The sandbox mounts its own empty /tmp and /run, so a file there is not what the nested desktop would read.
  local p
  for p in "$qs_path" "$hypr" "$fixtures"; do
    case "$p" in /tmp | /tmp/* | /run | /run/*) die "--desktop, --hypr and --fixtures cannot live under /tmp or /run (the sandbox hides both): $p" ;; *) ;; esac
  done
  [[ "$hypr" != *[\"\\]* ]] || die "--hypr path must not hold a quote or a backslash (it is written into a lua string)"
  [[ -z "$clock" || "$clock" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || die "--clock must be YYYY-MM-DD HH:MM:SS: $clock"
  [[ -z "$clock" || ! -x /usr/bin/hyprlock || -f /usr/lib/faketime/libfaketime.so.1 ]] \
    || die "--clock needs libfaketime for the slot's hyprlock (pacman -S libfaketime)"
  local tool
  for tool in bwrap sway swaymsg niri start-hyprland qs dbus-run-session pkg-config; do need "$tool"; done
  slot_alive "$name" && die "slot '$name' is already running"
  aq="$(slot_aquamarine_lib)" || exit 1
  node="$(slot_render_node)"
  [[ -n "$node" ]] || die "no non-nvidia render node for the desktop slot"
  dir="$(slot_dir "$name")"
  rt="$(slot_desktop_rt "$name")"
  rm -rf "${SLOT_ROOT:?}/${name:?}" "$rt"
  mkdir -p "$dir" "$rt"
  chmod 700 "$rt"
  slot_write_desktop_config "$dir" "$size" "$scale" "$hypr" "$inside"
  env -i HOME="$HOME" USER="${USER:-}" PATH="$PATH" LANG="${LANG:-C.UTF-8}" XDG_RUNTIME_DIR="$rt" \
    DRIVE_SLOT_ID="$dir" DRIVE_RENDER_NODE="$node" DRIVE_CLOCK="$clock" DRIVE_FIXTURES="$fixtures" DRIVE_AQUAMARINE="$aq" \
    setsid bwrap --ro-bind / / --dev /dev --tmpfs /dev/shm --dev-bind "$node" "$node" --proc /proc \
    --tmpfs /run --bind "$rt" "$rt" --bind "$dir" "$inside" --tmpfs /tmp \
    --unshare-pid --unshare-ipc --new-session \
    "$MOTION_DIR/slot-desktop" "$inside" "$qs_path" </dev/null >"$dir/sandbox.log" 2>&1 &
  echo $! >"$dir/pid"
  for ((i = 0; i < 150; i++)); do
    [[ -s "$dir/inner" ]] && break
    kill -0 "$(cat "$dir/pid")" 2>/dev/null || break
    sleep 0.2
  done
  [[ -s "$dir/inner" ]] || {
    slot_kill "$name"
    die "the nested desktop did not start in slot '$name' (logs were in $dir)"
  }
  slot_publish_desktop "$name" "$size" "$scale" "$qs_path"
  slot_hold "$name"
  printf 'slot %s: desktop=%s output=%s size=%s scale=%s hyprland=%s pid=%s\n' "$name" "$qs_path" \
    "$(slot_field "$name" SLOT_OUTPUT)" "$size" "$scale" "$(slot_field "$name" SLOT_HYPR_SIG)" "$(cat "$dir/pid")"
}

slot_publish_desktop() {
  local name="$1" size="$2" scale="$3" qs_path="$4" dir rt sock out
  dir="$(slot_dir "$name")"
  rt="$(slot_desktop_rt "$name")"
  sock="$(find "$rt" -maxdepth 1 -name 'sway-ipc.*.sock' | head -1)"
  out="$(slot_output_name "$sock")" || exit 1
  {
    printf 'SLOT_KIND=desktop\nSLOT_PID=%s\nSLOT_RT=%q\nSLOT_DISPLAY=%s\nSLOT_SWAYSOCK=%q\n' "$(cat "$dir/pid")" "$rt" "$(cat "$dir/display")" "$sock"
    printf 'SLOT_OUTPUT=%s\nSLOT_SIZE=%s\nSLOT_SCALE=%s\nSLOT_RENDERER=gles2\nSLOT_QS_PATH=%q\n' "$out" "$size" "$scale" "$qs_path"
    cat "$dir/inner"
  } >"$dir/state"
  printf '0 0\n' >"$dir/pos"
}

slot_run() {
  local name="${1:-}"
  [[ -n "$name" && "${2:-}" == "--" && $# -ge 3 ]] || die "slot run needs NAME -- CMD..."
  slot_load "$name"
  shift 2
  # A desktop slot's clients join the nested Hyprland, and hyprctl talks to it alone.
  [[ "${SLOT_KIND:-}" != desktop ]] || exec env -u DISPLAY QT_QPA_PLATFORM=wayland XDG_RUNTIME_DIR="$SLOT_RT" \
    WAYLAND_DISPLAY="$SLOT_CLIENT_DISPLAY" HYPRLAND_INSTANCE_SIGNATURE="$SLOT_HYPR_SIG" "$@"
  # A slot client must never reach the owner's compositor: a Hyprland-aware shell would dispatch to it.
  QT_QPA_PLATFORM=wayland exec env -u HYPRLAND_INSTANCE_SIGNATURE -u DISPLAY "$@"
}

# Starts a Workbench session inside the slot; its session file is what `drive geom --slot` reads.
slot_bench() {
  [[ $# -eq 3 ]] || die "slot bench needs NAME PROVIDER_ROOT STORY_KEY"
  need qsm-workbench
  local name="$1" dir
  dir="$(slot_dir "$name")"
  # One story per slot: the session file of the previous story would refuse the next start.
  if [[ -f "$dir/bench.json" ]]; then
    qsm-workbench session stop --session-file "$dir/bench.json" >/dev/null 2>&1
    rm -f "$dir/bench.json"
  fi
  (slot_run "$name" -- qsm-workbench session start --provider "$2" --story "$3" --session-file "$dir/bench.json" --log "$dir/bench.log") \
    | jq -r 'if .status == "error" then "drive: workbench did not start: \(.error) (\(.logPath))\n" | halt_error(1)
      else "workbench in slot '"$name"': pid=\(.session.pid) story=\(.describe.story)" end'
}

# TERM every process of the slot, KILL what is left after 3 s, remove its directory.
slot_kill() {
  local name="$1" i
  # shellcheck disable=SC2046
  kill $(slot_pids "$name") 2>/dev/null
  for ((i = 0; i < 30; i++)); do
    [[ -z "$(slot_pids "$name")" ]] && break
    sleep 0.1
  done
  # shellcheck disable=SC2046
  kill -9 $(slot_pids "$name") 2>/dev/null
  rm -rf "${SLOT_ROOT:?}/${name:?}" "$(slot_desktop_rt "$name")"
  rmdir "$SLOT_ROOT" 2>/dev/null
}

slot_stop() {
  local name="${1:-}"
  [[ -n "$name" && -d "$(slot_dir "$name")" ]] || die "slot stop needs the NAME of an existing slot (drive slot ls)"
  slot_kill "$name"
  printf 'slot %s stopped\n' "$name"
}

# Sum of resident set sizes (MB) over every process of the slot.
slot_rss_mb() {
  local pid total=0 kb
  for pid in $(slot_pids "$1"); do
    kb="$(awk '/^VmRSS:/{print $2}' "/proc/$pid/status" 2>/dev/null)"
    total=$((total + ${kb:-0}))
  done
  echo $((total / 1024))
}

slot_names() {
  local dir
  for dir in "$SLOT_ROOT"/*/; do
    [[ -d "$dir" ]] && basename "$dir"
  done
}

slot_ls() {
  local name
  for name in $(slot_names); do
    if slot_alive "$name"; then
      printf '%s display=%s size=%s scale=%s renderer=%s procs=%s rss=%sMB\n' "$name" "$(slot_field "$name" SLOT_DISPLAY)" \
        "$(slot_field "$name" SLOT_SIZE)" "$(slot_field "$name" SLOT_SCALE)" "$(slot_field "$name" SLOT_RENDERER)" \
        "$(slot_pids "$name" | wc -l)" "$(slot_rss_mb "$name")"
    else printf '%s dead (drive slot stop %s)\n' "$name" "$name"; fi
  done
}

slot_avail_mb() { awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo; }

# Waits until MemAvailable moves less than 8 MB between two reads 1 s apart (at most 30 s).
slot_settle() {
  local prev now i
  prev="$(slot_avail_mb)"
  for ((i = 0; i < 30; i++)); do
    sleep 1
    now="$(slot_avail_mb)"
    ((prev - now < 8 && now - prev < 8)) && return
    prev="$now"
  done
}

# Per-slot cost = the MemAvailable drop of one probe slot running a Workbench, which RSS sums
# overcount (shared pages) and miss (GPU and page cache); stopping the probe restores the memory.
slot_probe() {
  local before after
  slot_alive budget-probe && die "slot 'budget-probe' is running; stop it first"
  before="$(slot_avail_mb)"
  slot_start budget-probe >&2
  slot_bench budget-probe "$1" "$2" >&2 || { slot_kill budget-probe && die "probe failed"; }
  slot_settle
  after="$(slot_avail_mb)"
  slot_kill budget-probe
  ((before > after)) || die "probe slot did not lower MemAvailable ($before -> $after MB); measure again when the machine is idle"
  echo $((before - after))
}

# Slots that fit = (MemAvailable - reserve) / per-slot cost. The cost is measured once and cached in the slot root.
slot_budget() {
  local reserve=3072 per="" how=given provider="$PWD" story=level cache="$SLOT_ROOT/per-slot-mb" remeasure=""
  while (($#)); do
    case "$1" in
      --reserve-mb) reserve="${2:?--reserve-mb needs a number}" && shift 2 ;;
      --per-slot-mb) per="${2:?--per-slot-mb needs a number}" && shift 2 ;;
      --provider) provider="${2:?--provider needs a Workbench provider root}" && shift 2 ;;
      --story) story="${2:?--story needs a story key}" && shift 2 ;;
      --remeasure) remeasure=1 && shift ;;
      *) die "slot budget: unknown option '$1'" ;;
    esac
  done
  if [[ -z "$per" && -z "$remeasure" && -s "$cache" ]]; then per="$(<"$cache")" && how=cached; fi
  if [[ -z "$per" ]]; then
    need qsm-workbench
    per="$(slot_probe "$provider" "$story")" || exit 1
    mkdir -p "$SLOT_ROOT" && echo "$per" >"$cache"
    how=measured
  fi
  [[ "$per" =~ ^[1-9][0-9]*$ ]] || die "--per-slot-mb must be a positive number"
  local avail
  avail="$(slot_avail_mb)"
  printf 'available=%sMB reserve=%sMB per-slot=%sMB (%s) -> %s more slots fit\n' "$avail" "$reserve" "$per" "$how" \
    "$((avail > reserve ? (avail - reserve) / per : 0))"
}

# The Workbench item tree of the slot, in the shape geom.jq reads.
slot_tree() {
  local pid
  if [[ "$(slot_field "$1" SLOT_KIND)" == desktop ]]; then
    slot_load "$1"
    local tree
    tree="$(slot_run "$1" -- qs ipc --path "$SLOT_QS_PATH" call qsm inspect "$SLOT_NESTED_OUTPUT" true)" \
      || die "qs ipc inspect failed in slot '$1'"
    # A shell with no scene answers with an error object, not a tree.
    jq -e .tree >/dev/null 2>&1 <<<"$tree" || die "inspect in slot '$1' returned no tree: ${tree:0:200}"
    printf '%s\n' "$tree"
    return
  fi
  pid="$(jq -er .pid "$(slot_dir "$1")/bench.json" 2>/dev/null)" || die "no workbench in slot '$1' (drive slot bench $1 ROOT KEY)"
  qsm-workbench session request --pid "$pid" --json '{"version":1,"op":"inspect"}' | jq -f "$MOTION_DIR/slot-tree.jq" \
    || die "workbench inspect failed in slot '$1'"
}

cmd_slot() {
  local verb="${1:-}"
  shift || true
  case "$verb" in
    start | run | bench | stop | ls | budget | tree | aquamarine) "slot_$verb" "$@" ;;
    *) die "slot needs start NAME | run NAME -- CMD | bench NAME ROOT KEY | stop NAME | ls | budget | tree NAME | aquamarine" ;;
  esac
}

# ---- slot forms of pointer and keys: wlroots virtual pointer and keyboard ----

# Every pointer event goes through the holder's virtual pointer, the one device the slot's seat
# keeps, as one line on its control FIFO. Absolute motion is exact, so the position needs no tracking
# tricks; the pos file only remembers it for nudge and wake.
slot_ctl() {
  printf '%s\n' "$*" | timeout 2 tee "$(slot_dir "$DRIVE_SLOT")/ctl" >/dev/null || die "slot input holder is not reading (see $(slot_dir "$DRIVE_SLOT")/holder.log)"
}

slot_move() {
  [[ $# -ge 2 && "$1" =~ ^[0-9]+$ && "$2" =~ ^[0-9]+$ ]] || die "move needs X Y inside the slot output (non-negative integers)"
  local w h
  read -r w h < <(awk -v s="$SLOT_SIZE" -v k="$SLOT_SCALE" 'BEGIN{split(s,d,"x"); printf "%d %d\n", d[1]/k+0.5, d[2]/k+0.5}')
  slot_ctl abs "$1" "$2" "$w" "$h"
  printf '%s %s\n' "$1" "$2" >"$(slot_dir "$DRIVE_SLOT")/pos"
  printf 'cursor: %s,%s (slot %s)\n' "$1" "$2" "$DRIVE_SLOT"
  sleep "${3:-$SETTLE}"
}

# wf-recorder acts on SIGINT only when the compositor sends it an event, and a still headless
# output sends none: re-asserting the pointer position damages the output (software cursor).
slot_wake() {
  local x y
  read -r x y <"$(slot_dir "$DRIVE_SLOT")/pos"
  slot_move "$x" "$y" 0 >/dev/null
}

slot_pos() { sed 's/ /, /' "$(slot_dir "$DRIVE_SLOT")/pos"; }

slot_nudge() {
  local x y
  read -r x y <"$(slot_dir "$DRIVE_SLOT")/pos"
  slot_move "$((x + $1))" "$((y + $2))" "${3:-$SETTLE}"
}

slot_button() {
  case "${1:-left}" in
    left) echo 272 ;;
    right) echo 273 ;;
    middle) echo 274 ;;
    *) die "button must be left, right or middle" ;;
  esac
}

# press and release are one device event each, so a drag is press, move, release.
slot_press() { slot_ctl btn "$(slot_button "${1:-}")" 1 && sleep "${2:-0.2}"; }
slot_release() { slot_ctl btn "$(slot_button "${1:-}")" 0 && sleep "${2:-0.2}"; }

slot_click() {
  slot_press "$1" 0.08 && slot_release "$1" "${2:-0.4}"
}

# drive scroll: negative = down, which is a positive wheel.
slot_scroll() {
  slot_ctl wheel "$((-${1:--1}))"
  sleep "${2:-0.4}"
}

slot_type() {
  need wtype
  WAYLAND_DISPLAY="$SLOT_KEYBOARD" wtype -- "$1" || die "type failed"
  sleep "${2:-0.4}"
}

# xkb name for a drive key name: specials by table, a lone char lower-case, the rest Capitalised.
slot_xkb() {
  case "${1^^}" in
    ENTER | RETURN) echo Return ;;
    ESC | ESCAPE) echo Escape ;;
    SPACE) echo space ;;
    PAGEUP | PGUP) echo Page_Up ;;
    PAGEDOWN | PGDN) echo Page_Down ;;
    BACKSPACE) echo BackSpace ;;
    MINUS | COMMA | PERIOD | EQUAL | SLASH | BACKSLASH | SEMICOLON) echo "${1,,}" ;;
    ?) echo "${1,,}" ;;
    F[0-9] | F[0-9][0-9]) echo "${1^^}" ;;
    *) local low="${1,,}" && echo "${low^}" ;;
  esac
}

slot_mod() {
  case "${1^^}" in
    SUPER | META | LEFTMETA | MOD) echo logo ;;
    CTRL | CONTROL | LEFTCTRL) echo ctrl ;;
    SHIFT | LEFTSHIFT) echo shift ;;
    ALT | LEFTALT) echo alt ;;
    *) die "unknown modifier '$1'" ;;
  esac
}

# key [MODS] KEY [settle]: wtype holds each modifier around the key, like cmd_key does.
slot_key() {
  need wtype
  local mods="" key="$1" settle="${2:-0.6}" args=() m
  if [[ $# -ge 2 && -n "$1" && ! "$2" =~ ^[0-9.]+$ ]]; then
    mods="$1"
    key="$2"
    settle="${3:-0.6}"
  fi
  for m in $mods; do args+=(-M "$(slot_mod "$m")"); done
  args+=(-k "$(slot_xkb "$key")")
  for m in $mods; do args+=(-m "$(slot_mod "$m")"); done
  WAYLAND_DISPLAY="$SLOT_KEYBOARD" wtype "${args[@]}" || die "key failed"
  sleep "$settle"
}

# Select the slot from `--slot NAME` (anywhere before a bare --) or DRIVE_SLOT; leaves the rest in SLOT_ARGV.
slot_select() {
  SLOT_ARGV=()
  while (($#)); do
    case "$1" in
      --slot) DRIVE_SLOT="${2:?--slot needs a name}" && shift 2 ;;
      --) SLOT_ARGV+=("$@") && break ;;
      *) SLOT_ARGV+=("$1") && shift ;;
    esac
  done
  [[ -z "${DRIVE_SLOT:-}" ]] || { slot_load "$DRIVE_SLOT" && export DRIVE_SLOT; }
}

# In a slot, a verb that would reach the owner's Hyprland refuses instead.
slot_refuse() {
  case "$1" in
    warp | l2p | mons | doctor | contrast) die "'$1' reads or drives the owner's Hyprland; it has no slot form" ;;
    *) ;;
  esac
}
