{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "../../../.claude/types",
    "*.tsx",
    "ledger.ts",
    "report.ts",
    "pane.ts",
    "toon-wrap.ts",
    "noun.generated.ts",
    "*.test.ts",
    "../types"
  ]
}
