{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "../../../.claude/types",
    "register.tsx",
    "../lib/doctor.ts",
    "../lib/git-worktree-block.ts",
    "../lib/workspace.ts",
    "../lib/wt.ts"
  ]
}
