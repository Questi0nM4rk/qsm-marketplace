// qsm-langdev profile: strict. Seeded by `qsm-langdev init`; the repo owns this
// file. Every rule, not a curated subset: a finding here may be a
// defect or a smell, and both are worth an error.
//
// Every rule biome ships is on except the ones named below, and each of those
// carries why. Three kinds are named: rules for a framework this profile
// cannot know a repository uses (React, Vue, Solid, Qwik, Next, GraphQL, CSS,
// a11y — a wrong-framework rule does not stay quiet, it invents findings:
// useQwikValidLexicalScope reported 22 on a CLI that has never seen Qwik),
// rules this project decided against with the reason beside them, and the
// nursery group, which biome itself calls unstable, minus the one rule named
// back on inside it.
//
// There is no biome-ignore comment anywhere. A finding worth suppressing at a
// call site is evidence the rule was the wrong rule to enable, so it comes out
// here instead.
//
// Target: node. `node:` imports and `process` are the runtime, not a mistake.
{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": {
        "recommended": false,
        // The one nursery rule named back on. `a || fallback` takes the
        // fallback for "", 0, NaN and false, which are values a caller meant to
        // send; `a ?? fallback` takes it only for null and undefined. Measured
        // on this tree: 0 findings across 36 uses of ||, because every one of
        // them is boolean logic rather than a fallback. It costs nothing today
        // and catches the first one written.
        "useNullishCoalescing": "error"
      },
      "a11y": {
        "noAccessKey": "off",
        "noAmbiguousAnchorText": "off",
        "noAriaHiddenOnFocusable": "off",
        "noAriaUnsupportedElements": "off",
        "noAutofocus": "off",
        "noDistractingElements": "off",
        "noHeaderScope": "off",
        "noInteractiveElementToNoninteractiveRole": "off",
        "noLabelWithoutControl": "off",
        "noNoninteractiveElementInteractions": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "noNoninteractiveTabindex": "off",
        "noPositiveTabindex": "off",
        "noRedundantAlt": "off",
        "noRedundantRoles": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAltText": "off",
        "useAnchorContent": "off",
        "useAriaActivedescendantWithTabindex": "off",
        "useAriaPropsForRole": "off",
        "useAriaPropsSupportedByRole": "off",
        "useButtonType": "off",
        "useFocusableInteractive": "off",
        "useGenericFontNames": "off",
        "useHeadingContent": "off",
        "useHtmlLang": "off",
        "useIframeTitle": "off",
        "useKeyWithClickEvents": "off",
        "useKeyWithMouseEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off",
        "useValidAnchor": "off",
        "useValidAriaProps": "off",
        "useValidAriaRole": "off",
        "useValidAriaValues": "off",
        "useValidAutocomplete": "off",
        "useValidLang": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "noUselessFragments": "off"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "off",
        "noChildrenProp": "off",
        "noDuplicateArgumentNames": "off",
        "noDuplicateAttributes": "off",
        "noDuplicateEnumValueNames": "off",
        "noDuplicateInputFieldNames": "off",
        "noDuplicateVariableNames": "off",
        "noInvalidDirectionInLinearGradient": "off",
        "noInvalidGridAreas": "off",
        "noInvalidPositionAtImportRule": "off",
        "noMissingVarFunction": "off",
        "noNestedComponentDefinitions": "off",
        "noNextAsyncClientComponent": "off",
        "noNodejsModules": "off",
        "noProcessGlobal": "off",
        "noQwikUseVisibleTask": "off",
        "noReactPropAssignments": "off",
        "noRenderReturnValue": "off",
        "noRestrictedElements": "off",
        "noSolidDestructuredProps": "off",
        "noUnknownFunction": "off",
        "noUnknownMediaFeatureName": "off",
        "noUnknownProperty": "off",
        "noUnknownPseudoClass": "off",
        "noUnknownPseudoElement": "off",
        "noUnknownTypeSelector": "off",
        "noUnknownUnit": "off",
        "noUnmatchableAnbSelector": "off",
        "noVoidElementsWithChildren": "off",
        "noVueDataObjectDeclaration": "off",
        "noVueDuplicateKeys": "off",
        "noVueReservedKeys": "off",
        "noVueReservedProps": "off",
        "noVueSetupPropsReactivityLoss": "off",
        "noVueVIfWithVFor": "off",
        "useExhaustiveDependencies": "off",
        "useGraphqlNamedOperations": "off",
        "useHookAtTopLevel": "off",
        "useImageSize": "off",
        "useInlineScriptId": "off",
        "useJsxKeyInIterable": "off",
        "useLoneAnonymousOperation": "off",
        "useQwikClasslist": "off",
        "useQwikMethodUsage": "off",
        "useQwikValidLexicalScope": "off",
        "useUniqueElementIds": "off",
        "useVueVForKey": "off",
        "useVueValidTemplateRoot": "off",
        "useVueValidVBind": "off",
        "useVueValidVCloak": "off",
        "useVueValidVElse": "off",
        "useVueValidVElseIf": "off",
        "useVueValidVHtml": "off",
        "useVueValidVIf": "off",
        "useVueValidVOn": "off",
        "useVueValidVOnce": "off",
        "useVueValidVPre": "off",
        "useVueValidVText": "off"
      },
      "performance": {
        "noImgElement": "off",
        "noJsxPropsBind": "off",
        "noSyncScripts": "off",
        "noUnwantedPolyfillio": "off",
        "useGoogleFontPreconnect": "off",
        "useSolidForComponent": "off",
        // Every loop it flags runs ordered work that stops at the first
        // failure — the gate runner must not start a gate after one has
        // already failed. Running them together would change what the program
        // does, not just how fast it does it.
        "noAwaitInLoops": "off",
        "useTopLevelRegex": "off",
        "useVueVapor": "off"
      },
      "security": {
        // Two dedicated gates already own this and have allowlisting we
        // control: gitleaks as `secrets` and detect-secrets as `entropy`,
        // both at pre-commit. Biome's version fires on a git commit SHA and
        // on the CLI usage string, and its only escape is a per-line comment,
        // which this project does not write.
        "noSecrets": "off",
        "noBlankTarget": "off",
        "noDangerouslySetInnerHtml": "off",
        "noDangerouslySetInnerHtmlWithChildren": "off",
        "noScriptUrl": "off"
      },
      "style": {
        "noContinue": "off",
        "noDescendingSpecificity": "off",
        "noHeadElement": "off",
        "noHexColors": "off",
        "noImplicitBoolean": "off",
        "noJsxLiterals": "off",
        "noProcessEnv": "off",
        "noRootType": "off",
        // Biome flags the literals inside the named constant itself:
        // `const MAX_BYTES = 8 * 1024` reports both 8 and 1024, and so does
        // `const ABANDONED_MS = 60 * 60 * 1000`. The rest are numbers whose
        // meaning is at the use site — a `.toFixed(3)` precision, a
        // `slice(0, 80)` width, a regex capture index, a rounding epsilon
        // beside the comment that explains it. Extracting THREE for toFixed
        // makes the code worse.
        "noMagicNumbers": "off",
        // Four files are 675 to 717 lines against a cap of 300, and one of
        // them is a declarative registry where the length IS the data. File
        // length is a proxy for complexity, and two checks measure the thing
        // itself: lizard gates cyclomatic complexity per function, and
        // noExcessiveCognitiveComplexity is on below.
        "noExcessiveLinesPerFile": "off",
        // Every finding here is a snake_case property in a type describing
        // another program's JSON — sentrux's root_causes, cargo's, semgrep's.
        // Those names are a wire format, not ours to rename. The convention
        // still holds for the names this code does choose: functions,
        // variables, types, classes.
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
              },
              { "selector": { "kind": "typeProperty" }, "formats": ["camelCase", "snake_case"] }
            ]
          }
        },
        "noTernary": "off",
        "noValueAtRule": "off",
        "noVueOptionsApi": "off",
        "useComponentExportOnlyModules": "off",
        "useConsistentCurlyBraces": "off",
        "useConsistentGraphqlDescriptions": "off",
        "useDeprecatedReason": "off",
        "useExportsLast": "off",
        "useFragmentSyntax": "off",
        "useGraphqlNamingConvention": "off",
        "useInputName": "off",
        "useLoneExecutableDefinition": "off",
        "useReactFunctionComponents": "off",
        "useSelfClosingElements": "off",
        "useVueConsistentVBindStyle": "off",
        "useVueConsistentVOnStyle": "off",
        "useVueDefineMacrosOrder": "off",
        "useVueHyphenatedAttributes": "off",
        "useVueMultiWordComponentNames": "off"
      },
      "suspicious": {
        "noAlert": "off",
        "noArrayIndexKey": "off",
        "noDeprecatedMediaType": "off",
        "noDocumentCookie": "off",
        "noDocumentImportInPage": "off",
        "noDuplicateAtImportRules": "off",
        "noDuplicateCustomProperties": "off",
        "noDuplicateFields": "off",
        "noDuplicateFontNames": "off",
        "noDuplicateGraphqlOperationName": "off",
        "noDuplicateJsxProps": "off",
        "noDuplicateProperties": "off",
        "noDuplicateSelectorsKeyframeBlock": "off",
        "noDuplicatedSpreadProps": "off",
        "noEmptyBlock": "off",
        "noHeadImportInDocument": "off",
        "noImportantInKeyframe": "off",
        "noLeakedRender": "off",
        "noReactForwardRef": "off",
        "noReactSpecificProps": "off",
        "noShorthandPropertyOverrides": "off",
        "noSuspiciousSemicolonInJsx": "off",
        "noUnknownAtRules": "off",
        "noUnknownAttribute": "off",
        "noVueArrowFuncInWatch": "off",
        "useDeprecatedDate": "off",
        "useGoogleFontDisplay": "off"
      }
    }
  },
  "files": {
    // .tsx: a function-hooks module that draws UI (JSX has no valid syntax
    // in a plain .ts file); qsm-memory's register.tsx is the first.
    // The two generated files are derived from qsm.json by lib/generate-noun.ts
    // and proven fresh by the generated gate, so neither the formatter nor
    // the linter reads them: formatting a derived artefact only makes the
    // generator chase the formatter.
    "includes": [
      ".gates/**/*.ts",
      "lib/**/*.ts",
      "plugins/**/*.ts",
      "plugins/**/*.tsx",
      "!**/hooks/noun.generated.ts",
      "!**/types/index.d.ts",
      "!!.claude"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  // scripts/generate-profiles-data.ts embeds every profile config file as a
  // string literal, so this one generated file is config text by construction
  // and noSecrets reads its high-entropy lines as leaked credentials. The
  // rule stays on everywhere a person writes code.
  "overrides": [
    {
      // A function-hooks test is `test(name, async ($, on) => ...)`: the kit
      // from 'claude-code/testing' hands the engine and the hook registrar as
      // two parameters. noDoneCallback reads any second parameter as a
      // mocha-style done callback and reports every such test. The rule
      // stays on for bun:test files, where a second parameter would be one.
      "includes": ["plugins/*/hooks/*.test.ts", "plugins/*/hooks/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDoneCallback": "off"
          }
        }
      }
    },
    {
      "includes": ["plugins/qsm-langdev/lib/profiles-data.ts"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      // A gate and a build script are programs whose output IS the product:
      // `build-sentrux.ts <dir>` prints on stdout the path other code reads,
      // and a gate prints what it found. The CLI proper routes everything
      // through err() and json() and keeps the rule on. Learned the hard
      // way: an unsafe autofix deleted these calls, and the gate then failed
      // silently.
      "includes": ["**/.gates/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      // `bun:sqlite` and `bun:test` are real, bun-only built-in modules;
      // `bun run typecheck` resolves them fine via @types/bun. Biome's
      // resolver does not know the `bun:` protocol scheme and reports every
      // such import as unresolved, which is a Biome gap, not a broken
      // import. Scoped to the plugins that hit it (qsm-essentials' first
      // test file, `scripts/install.test.ts`, is where it first showed up
      // outside qsm-memory), plus root lib/ (generate-noun.test.ts).
      //
      // `claude-code` is the same kind of gap for a different reason: a
      // function-hooks module imports its types from the virtual module
      // `claude-code` (empty at runtime; the generated .claude/types/
      // claude-code.d.ts carries the real declarations, per hooks/tsconfig.json's
      // own include list). It is not, and never becomes, a package.json
      // dependency, so `noUndeclaredDependencies` is off for it too.
      "includes": [
        ".gates/**",
        "plugins/qsm-book-to-skill/**",
        "plugins/qsm-builder/**",
        "plugins/qsm-cockpit/**",
        "plugins/qsm-essentials/**",
        "plugins/qsm-forge/**",
        "plugins/qsm-index/**",
        "plugins/qsm-knowledge/**",
        "plugins/qsm-langdev/**",
        "plugins/qsm-langdev-dotnet/**",
        "plugins/qsm-langdev-fish/**",
        "plugins/qsm-langdev-py/**",
        "plugins/qsm-langdev-shell/**",
        "plugins/qsm-langdev-ts/**",
        "plugins/qsm-langdev-zsh/**",
        "plugins/qsm-memory/**",
        "plugins/qsm-openspec/**",
        "plugins/qsm-plan/**",
        "plugins/qsm-review/**",
        "plugins/qsm-secrets/**",
        "plugins/qsm-setup/**",
        "plugins/qsm-statusline/**",
        "plugins/qsm-tasks/**",
        "plugins/qsm-toolbox/**",
        "plugins/qsm-uix/**",
        "plugins/qsm-usage/**",
        "plugins/qsm-web/**",
        "plugins/qsm-worktrunk/**",
        "lib/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off",
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      // tsconfig.qsm.json turns on `noUncheckedIndexedAccess`: `Record<K,V>`
      // indexing is `V | undefined` until narrowed, project-wide, on
      // purpose. Biome's own inference for `noUnnecessaryConditions` does
      // not model that flag — it treats `Record` indexing as always
      // defined, so it calls the resulting `?? fallback` guard on a
      // `Record<string, string[]>` "unreachable" while `tsc --noEmit`
      // requires it (verified: removing the guard is a real TS2532 in this
      // file, not a Biome false alarm dressed up as one). Scoped to the one
      // test that hits this shape rather than off everywhere, so a real
      // unnecessary condition elsewhere still fails the gate.
      "includes": ["plugins/qsm-memory/lib/notes-layer.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
