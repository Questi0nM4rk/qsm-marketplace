{
  "extends": "./tsconfig.qsm.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [".gates/**/*.ts", "lib/**/*.ts", "plugins/**/*.ts"],
  // A function-hooks module imports type-only from the ambient module
  // 'claude-code', which only exists under the generated declarations a
  // hooks/tsconfig.json includes (plugin-authoring skill; CLAUDEMODS.md
  // section 10). The root config has no such include, so it cannot resolve
  // that module: excluded here, typechecked instead through each hooks
  // module's own tsconfig (`bun check -p plugins/<name>/hooks`).
  "exclude": [
    "node_modules",
    "**/dist/**",
    "plugins/*/hooks/register.ts",
    "plugins/*/hooks/*.generated.ts",
    "plugins/*/hooks/*.test.ts"
  ]
}
